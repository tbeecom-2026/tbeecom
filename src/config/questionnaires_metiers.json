{
  "_meta": {
    "titre": "Questionnaires dynamiques par métier - Fonds de commerce TBEECOM",
    "version": "1.0",
    "date": "2026-06-16",
    "description": "Config pilotant le formulaire d'ajout de bien. Les champs metier sont stockes dans la colonne JSONB 'attributs' de la table mandats. Les champs communs correspondent aux colonnes existantes.",
    "usage": "Le formulaire affiche d'abord type_bien (categorie). Si categorie = 'Fonds de commerce en vente', on affiche le selecteur 'famille_metier'. Le choix de la famille charge le bloc de champs correspondant dans 'metiers'. Tous les champs communs s'affichent quel que soit le metier.",
    "types_champ": {
      "number": "saisie numerique",
      "text": "texte libre court",
      "textarea": "texte libre long",
      "boolean": "oui / non",
      "select": "liste deroulante (mono-choix)",
      "multiselect": "liste a choix multiples",
      "date": "date"
    }
  },

  "type_bien": {
    "key": "categorie",
    "label": "Type de bien",
    "type": "select",
    "required": true,
    "options": [
      "Fonds de commerce en vente",
      "Droit au bail en vente",
      "Immobilier Pro en vente",
      "Immobilier Pro en location",
      "Murs commerciaux en vente",
      "Appartement en vente",
      "Maison en vente",
      "Immeuble en vente",
      "Terrain en vente",
      "Stationnement en vente",
      "Entreprise en vente"
    ],
    "declenche_questionnaire_metier_si": "Fonds de commerce en vente"
  },

  "famille_metier": {
    "key": "famille_metier",
    "label": "Nature du fonds de commerce",
    "type": "select",
    "required": true,
    "stockage": "attributs.famille_metier",
    "options": [
      { "valeur": "restauration_assise", "label": "Restauration assise (restaurant, brasserie, pizzeria, creperie, bistrot)" },
      { "valeur": "bar_cafe_tabac", "label": "Bar / Cafe / Pub / Tabac" },
      { "valeur": "restauration_rapide", "label": "Restauration rapide (fast-food, kebab, burger, sandwicherie)" },
      { "valeur": "boulangerie_patisserie", "label": "Boulangerie / Patisserie / Chocolaterie / Salon de the" },
      { "valeur": "garage_carrosserie", "label": "Garage / Carrosserie / Reparation auto" },
      { "valeur": "fleuriste", "label": "Fleuriste" },
      { "valeur": "coiffure_esthetique", "label": "Coiffure / Esthetique / Beaute" },
      { "valeur": "autre", "label": "Autre commerce (questionnaire generique)" }
    ]
  },

  "champs_communs": {
    "description": "Champs valables pour tout fonds de commerce. La plupart existent deja comme colonnes de la table mandats.",
    "blocs": [
      {
        "titre": "Identite du bien",
        "champs": [
          { "key": "reference", "label": "Reference du bien", "type": "text", "colonne": "reference", "aide": "Code interne, ex: VF797. Laisser vide pour completer plus tard." },
          { "key": "titre", "label": "Titre de l'annonce", "type": "text", "required": true, "colonne": "titre" },
          { "key": "enseigne", "label": "Enseigne", "type": "text", "colonne": "enseigne" },
          { "key": "nature_activite", "label": "Nature precise de l'activite", "type": "text", "colonne": "nature_activite", "aide": "Ex: Boulangerie-patisserie artisanale. Champ libre, en plus de la famille." },
          { "key": "description", "label": "Description", "type": "textarea", "colonne": "description" },
          { "key": "raison_vente", "label": "Raison de la vente", "type": "select", "colonne": "raison_vente", "options": ["Depart retraite", "Changement de vie", "Reconversion", "Sante", "Demenagement", "Autre projet", "Cession multi-etablissements", "Autre"] }
        ]
      },
      {
        "titre": "Localisation",
        "champs": [
          { "key": "adresse", "label": "Adresse", "type": "text", "colonne": "adresse" },
          { "key": "code_postal", "label": "Code postal", "type": "text", "colonne": "code_postal" },
          { "key": "commune", "label": "Commune", "type": "text", "colonne": "commune" },
          { "key": "secteur", "label": "Secteur / quartier", "type": "text", "colonne": "secteur" },
          { "key": "type_emplacement", "label": "Type d'emplacement", "type": "select", "stockage": "attributs", "options": ["Centre-ville", "Quartier residentiel", "Zone commerciale", "Centre commercial / galerie", "Axe passant", "Rural", "Touristique"] }
        ]
      },
      {
        "titre": "Surfaces",
        "champs": [
          { "key": "surface_totale", "label": "Surface totale", "type": "number", "unite": "m2", "colonne": "surface_totale" },
          { "key": "surface_commerciale", "label": "Surface commerciale / vente", "type": "number", "unite": "m2", "colonne": "surface_commerciale" },
          { "key": "surface_reserves", "label": "Surface reserves / stockage", "type": "number", "unite": "m2", "colonne": "surface_reserves" },
          { "key": "repartition_surface", "label": "Repartition des surfaces (detail)", "type": "textarea", "colonne": "repartition_surface" }
        ]
      },
      {
        "titre": "Finances",
        "champs": [
          { "key": "ca_annuel", "label": "Chiffre d'affaires annuel", "type": "number", "unite": "EUR", "colonne": "ca_annuel" },
          { "key": "resultat_net", "label": "Resultat net / EBE", "type": "number", "unite": "EUR", "colonne": "resultat_net" },
          { "key": "ca_n1", "label": "CA exercice N-1", "type": "number", "unite": "EUR", "stockage": "attributs" },
          { "key": "ca_n2", "label": "CA exercice N-2", "type": "number", "unite": "EUR", "stockage": "attributs" },
          { "key": "ebe_retraite", "label": "EBE retraite", "type": "number", "unite": "EUR", "stockage": "attributs" },
          { "key": "effectif", "label": "Effectif repris (ETP)", "type": "number", "unite": "salaries", "colonne": "effectif" }
        ]
      },
      {
        "titre": "Prix & honoraires",
        "champs": [
          { "key": "prix_demande", "label": "Prix demande (FAI)", "type": "number", "unite": "EUR", "colonne": "prix_demande" },
          { "key": "prix_net_vendeur", "label": "Prix net vendeur", "type": "number", "unite": "EUR", "colonne": "prix_net_vendeur", "aide": "Saisir le net vendeur calcule automatiquement les honoraires et le prix FAI selon le barème (modifiables ensuite)." },
          { "key": "honoraires_montant", "label": "Honoraires", "type": "number", "unite": "EUR", "colonne": "honoraires_montant" },
          { "key": "honoraires_charge", "label": "Honoraires a charge", "type": "select", "colonne": "honoraires_charge", "options": ["Acquereur", "Vendeur", "Partage"] }
        ]
      },
      {
        "titre": "Bail & murs",
        "champs": [
          { "key": "loyer_annuel", "label": "Loyer annuel", "type": "number", "unite": "EUR", "stockage": "attributs" },
          { "key": "loyer_tva_regime", "label": "Régime TVA du loyer", "type": "select", "stockage": "attributs", "options": ["HT (hors taxes)", "TTC (toutes taxes comprises)", "Sans TVA (non assujetti)"], "aide": "Précise si le loyer saisi est HT, TTC ou sans TVA." },
          { "key": "charges_annuelles", "label": "Charges annuelles", "type": "number", "unite": "EUR", "stockage": "attributs", "aide": "Montant annuel des charges locatives." },
          { "key": "charges_details", "label": "Détail des charges", "type": "textarea", "stockage": "attributs", "aide": "Ex: eau, électricité, chauffage, charges de copropriété, ordures ménagères..." },
          { "key": "taxe_fonciere_montant", "label": "Taxe foncière (annuelle)", "type": "number", "unite": "EUR", "stockage": "attributs" },
          { "key": "taxe_fonciere_charge", "label": "Taxe foncière à charge de", "type": "select", "stockage": "attributs", "options": ["Bailleur", "Locataire", "Partagée"] },
          { "key": "bail_annees_restantes", "label": "Annees restantes du bail", "type": "number", "unite": "annees", "stockage": "attributs" },
          { "key": "bail_destination", "label": "Destination du bail", "type": "text", "stockage": "attributs", "aide": "Activites autorisees par le bail." },
          { "key": "depot_garantie", "label": "Depot de garantie", "type": "number", "unite": "EUR", "stockage": "attributs" },
          { "key": "murs_a_vendre", "label": "Murs a vendre", "type": "boolean", "colonne": "murs_a_vendre" },
          { "key": "prix_murs", "label": "Prix des murs", "type": "number", "unite": "EUR", "colonne": "prix_murs", "affiche_si": "murs_a_vendre = true" },
          { "key": "murs_meme_proprietaire", "label": "Le propriétaire du fonds est-il propriétaire des murs ?", "type": "select", "stockage": "attributs", "options": ["Oui", "Non", "Indivision / partiel"] },
          { "key": "logement_attache", "label": "Logement de fonction attaché", "type": "boolean", "stockage": "attributs" },
          { "key": "logement_type", "label": "Type de logement", "type": "select", "stockage": "attributs", "options": ["Appartement", "Maison"], "affiche_si": "logement_attache = true" },
          { "key": "logement_typologie", "label": "Typologie du logement", "type": "select", "stockage": "attributs", "options": ["Studio / T1", "T2", "T3", "T4", "T5 et +"], "affiche_si": "logement_attache = true" },
          { "key": "logement_etat", "label": "État du logement", "type": "select", "stockage": "attributs", "options": ["Neuf / récent", "Bon état", "À rafraîchir", "À rénover"], "affiche_si": "logement_attache = true" }
        ]
      },
      {
        "titre": "Exploitation",
        "champs": [
          { "key": "horaires_ouverture", "label": "Horaires / jours d'ouverture", "type": "textarea", "colonne": "horaires_ouverture" },
          { "key": "conges_annuels", "label": "Congés annuels / fermeture annuelle", "type": "text", "stockage": "attributs", "aide": "Ex: 3 semaines en août + 1 semaine à Noël." },
          { "key": "accessibilite_pmr", "label": "Accessibilité handicapés (normes PMR / ERP)", "type": "select", "stockage": "attributs", "options": ["Conforme", "Non conforme", "Dérogation obtenue", "À vérifier"] },
          { "key": "type_mandat", "label": "Type de mandat", "type": "select", "colonne": "type_mandat", "options": ["Simple", "Exclusif", "Semi-exclusif", "Delegation"] },
          { "key": "statut", "label": "Statut commercial", "type": "select", "colonne": "statut", "options": ["Prospection", "Sur le marche", "Sous compromis", "Vendu", "Retire", "Archive"] }
        ]
      },
      {
        "titre": "Proprietaire / mandant",
        "champs": [
          { "key": "proprietaire_nom", "label": "Nom du proprietaire", "type": "text", "colonne": "proprietaire_nom" },
          { "key": "proprietaire_societe", "label": "Societe", "type": "text", "colonne": "proprietaire_societe" },
          { "key": "proprietaire_email", "label": "Email", "type": "text", "colonne": "proprietaire_email" },
          { "key": "proprietaire_tel", "label": "Telephone", "type": "text", "colonne": "proprietaire_tel" }
        ]
      }
    ]
  },

